# Postgres. Production: Neon's pooled connection string.
DATABASE_URL=postgres://localhost/docwise

# Claude API key (https://console.anthropic.com). Not needed with DOCWISE_FAKE_MODEL=1.
ANTHROPIC_API_KEY=
# Optional: compare another model (default claude-sonnet-5-5).
# DOCWISE_MODEL=
# Local development without an API key: a fake model that always returns the same invoice.
# DOCWISE_FAKE_MODEL=1

# File storage: a private Cloudflare R2 bucket (API token with Object Read & Write on the bucket)...
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=docwise-uploads
# ...or local disk for development (files under .data/storage).
# STORAGE_DRIVER=local

# Uploads accepted per rolling 24 hours across the public demo (default 50).
# DOCWISE_DAILY_UPLOADS=50
# Estimated model spend per rolling 24 hours, in US dollars, across the demo (default 2).
# DOCWISE_DAILY_BUDGET_USD=2

# End-to-end tests (npm run test:e2e) use their own database (default postgres://localhost/docwise_e2e).
# E2E_DATABASE_URL=
